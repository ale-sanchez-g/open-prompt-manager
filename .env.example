# Repo-root environment variables.
#
# Consumed by docker-compose (variable substitution, e.g. ${JWT_SECRET}) and
# the backend service — NOT by the frontend. Vite reads its own env from the
# frontend/ directory (see frontend/.env.example).
#
# Usage:
#   cp .env.example .env           # .env is git-ignored; put real values there

# --- Backend / API -------------------------------------------------------
# Secret used to sign JWTs. REQUIRED. Generate a strong random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_hex_string

# Comma-separated list of admin user emails.
ADMIN_EMAILS=admin@example.com

# Rate limiting (requests per minute).
RATE_LIMIT_PER_MINUTE=3000
RATE_LIMIT_AUTH_PER_MINUTE=500

# --- Datadog telemetry (optional) ---------------------------------------
DD_APP_KEY=
DD_API_KEY=

# --- Flagsmith feature flags (backend) ----------------------------------
# Server-side key for the backend SDK. Leave EMPTY and every backend flag
# resolves to false — the right setting for local development and CI, and the
# reason the test suite needs no Flagsmith account.
#
# SECRET. This is the `ser.…` server-side key, NOT the frontend's publishable
# environment ID. Never put it in a client bundle or a Vite variable: a leaked
# server key exposes every flag and segment rule in the environment.
FLAGSMITH_SERVER_KEY=

# API base. Default is the Flagsmith SaaS Edge API.
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/

# Local-evaluation poll interval, in seconds. The backend polls one environment
# document on this timer instead of calling the API per request. 300 is a floor
# enforced in code, not a preference: the project's monthly API-call budget does
# not survive a faster poll multiplied by the running ECS tasks. Raising it
# slows flag propagation, which is also how fast a rollback takes effect —
# see docs/FEATURE_FLAGS.md and docs/features/registration-feature.md §3.4/§3.5.
FLAGSMITH_REFRESH_INTERVAL_SECONDS=300

# --- Flagsmith feature flags (frontend) ---------------------------------
# The FRONTEND's flag settings belong in frontend/.env.local (or the frontend
# image's build args) because Vite does not read this root file. Listed here
# only as a pointer — see frontend/.env.example and docs/FEATURE_FLAGS.md for
# the authoritative reference.
#
# Project: opm-dx1  |  Client-side environment keys are publishable (non-secret).
#   VITE_FLAGSMITH_ENVIRONMENT_ID=<Development client-side key>
#   VITE_FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
