# Frontend environment variables (Vite).
#
# Vite runs from this `frontend/` directory, so it reads env files FROM HERE
# (frontend/.env, frontend/.env.local) — NOT the repo-root .env. Only vars
# prefixed with VITE_ are exposed to browser code via import.meta.env.
#
# Usage:
#   cp .env.example .env.local     # .env.local is git-ignored; put real values there
#
# NOTE: these are baked in at BUILD time (`npm run build` / the frontend
# Dockerfile). Changing a value requires a rebuild, not just a restart.

# --- API -----------------------------------------------------------------
# Base URL for the backend API. Empty string uses same-origin + the Vite dev
# proxy (see vite.config.js), which is the usual local-dev setting.
VITE_API_URL=

# --- Flagsmith feature flags --------------------------------------------
# See docs/FEATURE_FLAGS.md. Project: opm-dx1 (org: SLO Edication).
# Use the *client-side* Environment key (publishable, safe in the browser
# bundle) — NOT a server-side (ser_...) key.
#
#   Get it from: Flagsmith -> project opm-dx1 -> Environment -> SDK Keys.
#   Point local dev at the Development environment.
#
# Required to ENABLE flags. If unset, the SDK never starts and every flag
# resolves to its default (current/safe behaviour).
VITE_FLAGSMITH_ENVIRONMENT_ID=your_client_side_environment_key

# Optional. Flagsmith API base; override for self-hosted / regional edge.
VITE_FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/

# Optional kill switch. Set to false/0/no/off to force-disable flags even
# when an Environment ID is present. Default: enabled when the ID is set.
# VITE_FLAGSMITH_ENABLED=true
