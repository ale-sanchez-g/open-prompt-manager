# Loaded by Vite/Vitest in test mode (committed, not git-ignored).
# Force feature flags OFF in tests so components that read flags render
# without a live Flagsmith provider and fall back to their safe defaults.
# Tests that need a flag ON should mock useFeatureFlag directly (see
# DashboardWelcomeBanner.test.jsx and docs/FEATURE_FLAGS.md §9).
VITE_FLAGSMITH_ENABLED=false
